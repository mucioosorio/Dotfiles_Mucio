{
    "layer": "top",
    "position": "top",
    "height": 24,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["bluetooth", "network", "pulseaudio", "pulseaudio#mic", "custom/weather", "clock"],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true
    },

    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  Wired",
        "format-disconnected": "󰖪  Offline",
        "on-click": "nm-connection-editor"
    },

"pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": {
        "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
},


"clock": {
    "format": "{:%H:%M  %a %d %b}",
    "on-click": "~/.config/waybar/scripts/calendar.sh"
} ,
   
    "bluetooth": {
    "format": " {status}",
    "format-disabled": " off",
    "on-click": "blueman-manager"
    },

"custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "interval": 1800,
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/weather-full.sh"
},

"pulseaudio#mic": {
    "format": " {volume}%",
    "format-muted": " muted",
    "source": "@DEFAULT_SOURCE@",
    "on-click": "pavucontrol"
}

}

   
